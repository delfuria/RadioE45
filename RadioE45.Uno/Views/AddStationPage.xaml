<Page
    x:Class="RadioE45.Views.AddStationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:RadioE45.Services.Localization"
    xmlns:conv="using:RadioE45.Converters"
    xmlns:vm="using:RadioE45.ViewModels"
    Background="{ThemeResource PageBackgroundBrush}">

    <!-- Port of RadioE45/Views/AddStationPage.xaml. Enter in the URL box = search (MAUI ReturnCommand). -->

    <Grid Padding="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitleLabel}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

        <!-- Search bar -->
        <Grid Grid.Row="1" ColumnSpacing="8" Padding="16,8,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                Style="{StaticResource CardTextBox}"
                PlaceholderText="{loc:Translate Key=AddStation_UrlPlaceholder}"
                Text="{x:Bind ViewModel.UrlBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                InputScope="Url"
                IsSpellCheckEnabled="False"
                KeyDown="OnUrlKeyDown" />
            <Button
                Grid.Column="1"
                Content="{loc:Translate Key=AddStation_Search}"
                Command="{x:Bind ViewModel.SearchCommand}"
                IsEnabled="{x:Bind conv:Fn.Not(ViewModel.IsBusy), Mode=OneWay}"
                Background="{StaticResource AccentBrush}"
                Foreground="{ThemeResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="16,0"
                VerticalAlignment="Stretch" />
        </Grid>

        <!-- Error message -->
        <TextBlock
            Grid.Row="2"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Foreground="Red"
            FontSize="13"
            TextWrapping="Wrap"
            Margin="16,8,16,0"
            Visibility="{x:Bind conv:Fn.IsNotNull(ViewModel.ErrorMessage), Mode=OneWay}" />

        <!-- Main area -->
        <Grid Grid.Row="3">

            <!-- Loading / initial state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Margin="32,0"
                Visibility="{x:Bind conv:Fn.Collapsed(ViewModel.HasResults), Mode=OneWay}">
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="{loc:Translate Key=AddStation_Prompt}"
                    Style="{StaticResource CaptionLabel}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind conv:Fn.Collapsed(ViewModel.IsBusy), Mode=OneWay}" />
            </StackPanel>

            <!-- Results -->
            <Grid Margin="0,8,0,0" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}">
                <TextBlock
                    Text="{loc:Translate Key=AddStation_NoResults}"
                    FontSize="18"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    Margin="32,48,32,0"
                    Visibility="{x:Bind conv:Fn.IsEmpty(ViewModel.AvailableStations), Mode=OneWay}" />

                <ListView
                    ItemsSource="{x:Bind ViewModel.AvailableStations, Mode=OneWay}"
                    SelectionMode="None"
                    Padding="0,0,0,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="16,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:StationSelectionItem">
                            <Border Style="{StaticResource CardBorder}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock
                                            Text="{x:Bind Station.Name}"
                                            Foreground="{ThemeResource PrimaryTextBrush}"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{x:Bind Station.Description}"
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            FontSize="13"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind Station.HasDescription}" />
                                    </StackPanel>

                                    <!-- Checkbox for selectable stations -->
                                    <CheckBox
                                        Grid.Column="1"
                                        MinWidth="0"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                        Visibility="{x:Bind conv:Fn.Collapsed(IsAlreadyAdded)}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                    <!-- Checkmark for already-added stations -->
                                    <FontIcon
                                        Grid.Column="1"
                                        FontFamily="{StaticResource FaSolid}"
                                        Glyph="&#xf00c;"
                                        FontSize="18"
                                        Foreground="{StaticResource AccentBrush}"
                                        Visibility="{x:Bind IsAlreadyAdded}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Add selected / cancel -->
        <Button
            Grid.Row="4"
            Style="{StaticResource PillAccentButton}"
            Content="{x:Bind ViewModel.BottomButtonText, Mode=OneWay}"
            Command="{x:Bind ViewModel.BottomActionCommand}"
            IsEnabled="{x:Bind conv:Fn.Not(ViewModel.IsBusy), Mode=OneWay}"
            Margin="32,8,32,0" />
    </Grid>

</Page>
