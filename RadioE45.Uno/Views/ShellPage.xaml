<Page
    x:Class="RadioE45.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:RadioE45.Services.Localization"
    xmlns:conv="using:RadioE45.Converters"
    xmlns:models="using:RadioE45.Models"
    Background="{ThemeResource PageBackgroundBrush}">

    <!-- Counterpart of RadioE45/AppShell.xaml. Station pages are tabs; Channels, Settings, Add
         station and Edit station are stacked in the same Frame above On Air, with the back button
         (MAUI: Shell routes pushed on the On Air tab). The side menu (MAUI: Shell.FlyoutContent)
         is a pane that slides in over the pages, opened by the ☰ button of the pages
         (Controls/MenuButton) and closed by a click outside or Esc. Not a SplitView: on Uno its
         pane shows fully open for a frame before the opening animation. The schedule
         (MAUI: SchedulePopup) is a sheet that slides up from the bottom in the same way. -->
    <Grid x:Name="MenuHost" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Auto"
            IsSettingsVisible="False"
            IsBackEnabled="False"
            BackRequested="OnBackRequested"
            ItemInvoked="OnItemInvoked">

            <NavigationView.MenuItems>
                <!-- Tab icons: Font Awesome glyphs for the MAUI tab_onair, tab_request and tab_podcast
                     images (fixed white or red, while a glyph follows the theme and the selection) -->
                <NavigationViewItem x:Name="TabOnAir" Content="{loc:Translate Key=Tab_OnAir}" Tag="OnAir">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FaSolid}" Glyph="&#xf04b;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="TabRequest"
                    Content="{loc:Translate Key=Tab_Request}"
                    Tag="Request"
                    Visibility="{x:Bind OnAirViewModel.NowPlaying.RequestsEnabled, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FaSolid}" Glyph="&#xf001;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="TabPodcasts"
                    Content="{loc:Translate Key=Tab_Podcasts}"
                    Tag="Podcasts"
                    Visibility="{x:Bind OnAirViewModel.HasPodcasts, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FaSolid}" Glyph="&#xf130;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Navigated="OnFrameNavigated" />
        </NavigationView>

        <!-- Light dismiss: a click outside the menu closes it -->
        <Rectangle
            x:Name="MenuDismissLayer"
            Fill="#80000000"
            Opacity="0"
            Visibility="Collapsed"
            Tapped="OnDismissLayerTapped" />

        <Border
            x:Name="MenuPane"
            Width="280"
            HorizontalAlignment="Left"
            Background="{ThemeResource CardBackgroundBrush}"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MenuPaneTransform" X="-280" />
            </Border.RenderTransform>
            <ScrollViewer>
                <StackPanel Padding="0,24,0,16">

                    <StackPanel.Resources>
                        <Style x:Key="MenuIcon" TargetType="FontIcon">
                            <Setter Property="FontFamily" Value="{StaticResource FaSolid}" />
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="MenuText" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="MenuRow" TargetType="Grid">
                            <Setter Property="ColumnSpacing" Value="16" />
                            <Setter Property="Padding" Value="20,0" />
                            <Setter Property="MinHeight" Value="52" />
                        </Style>
                    </StackPanel.Resources>

                    <!-- Header: current station -->
                    <Grid ColumnSpacing="12" Padding="20,0,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="56"
                            Height="56"
                            CornerRadius="12"
                            Background="{ThemeResource CardElevatedBrush}">
                            <Grid>
                                <!-- Placeholder always underneath: it also shows when the logo fails to load (web, CORS) -->
                                <Image Source="ms-appx:///Assets/Images/radio_placeholder.png" Stretch="Uniform" Margin="10" />
                                <Image
                                    Source="{x:Bind conv:Fn.Image(ViewModel.StationLogoUrl), Mode=OneWay}"
                                    Stretch="UniformToFill"
                                    Visibility="{x:Bind conv:Fn.IsNotNull(ViewModel.StationLogoUrl), Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Text="{x:Bind ViewModel.StationName, Mode=OneWay}"
                                Foreground="{ThemeResource PrimaryTextBrush}"
                                FontSize="18"
                                FontWeight="Bold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Radio E45" Foreground="{ThemeResource MutedTextBrush}" FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,0,0,8" />

                    <!-- Channels -->
                    <Button Style="{StaticResource RowButton}" Command="{x:Bind ViewModel.OpenChannelsCommand}">
                        <Grid Style="{StaticResource MenuRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xf8d7;" Style="{StaticResource MenuIcon}" />
                            <TextBlock Grid.Column="1" Text="{loc:Translate Key=Tab_Radio}" Style="{StaticResource MenuText}" />
                        </Grid>
                    </Button>

                    <!-- Settings -->
                    <Button Style="{StaticResource RowButton}" Command="{x:Bind ViewModel.OpenSettingsCommand}">
                        <Grid Style="{StaticResource MenuRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xf013;" Style="{StaticResource MenuIcon}" />
                            <TextBlock Grid.Column="1" Text="{loc:Translate Key=Tab_Settings}" Style="{StaticResource MenuText}" />
                        </Grid>
                    </Button>

                    <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,8" />

                    <!-- Website -->
                    <Button
                        Style="{StaticResource RowButton}"
                        Command="{x:Bind ViewModel.OpenLinkCommand}"
                        CommandParameter="{x:Bind ViewModel.Website, Mode=OneWay}"
                        Visibility="{x:Bind conv:Fn.IsNotNull(ViewModel.Website), Mode=OneWay}">
                        <Grid Style="{StaticResource MenuRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xf0ac;" Style="{StaticResource MenuIcon}" />
                            <TextBlock Grid.Column="1" Text="{loc:Translate Key=Menu_Website}" Style="{StaticResource MenuText}" />
                        </Grid>
                    </Button>

                    <!-- Social: up to 3 icons side by side -->
                    <Grid Style="{StaticResource MenuRow}" Visibility="{x:Bind ViewModel.HasSocialLinks, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xf1e0;" Style="{StaticResource MenuIcon}" />
                        <TextBlock Grid.Column="1" Text="{loc:Translate Key=Menu_Social}" Style="{StaticResource MenuText}" />
                        <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.SocialLinks, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StationLink">
                                    <Button
                                        Content="{x:Bind Glyph}"
                                        FontFamily="{x:Bind conv:Fn.Font(FontFamily)}"
                                        Style="{StaticResource MenuLinkButton}"
                                        AutomationProperties.Name="{x:Bind Uri.Host}"
                                        Tag="{x:Bind}"
                                        Click="OnLinkClick" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Contacts: email and phone side by side -->
                    <Grid Style="{StaticResource MenuRow}" Visibility="{x:Bind ViewModel.HasContactLinks, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xf2b9;" Style="{StaticResource MenuIcon}" />
                        <TextBlock Grid.Column="1" Text="{loc:Translate Key=Menu_Contacts}" Style="{StaticResource MenuText}" />
                        <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.ContactLinks, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StationLink">
                                    <Button
                                        Content="{x:Bind Glyph}"
                                        FontFamily="{x:Bind conv:Fn.Font(FontFamily)}"
                                        Style="{StaticResource MenuLinkButton}"
                                        AutomationProperties.Name="{x:Bind Uri.OriginalString}"
                                        Tag="{x:Bind}"
                                        Click="OnLinkClick" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <TextBlock
                        Text="{x:Bind ViewModel.AppVersion}"
                        Foreground="{ThemeResource MutedTextBrush}"
                        FontSize="12"
                        Margin="20,24,20,0" />

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom sheet (MAUI: toolkit Popup at the bottom, e.g. the schedule), same light
             dismiss and animation approach as the side menu, sliding up -->
        <Rectangle
            x:Name="SheetDismissLayer"
            Fill="#80000000"
            Opacity="0"
            Visibility="Collapsed"
            Tapped="OnSheetDismissLayerTapped" />

        <Border
            x:Name="SheetPane"
            VerticalAlignment="Bottom"
            CornerRadius="20,20,0,0"
            Background="{ThemeResource PageBackgroundBrush}"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SheetPaneTransform" />
            </Border.RenderTransform>
        </Border>

        <!-- Centered panel (MAUI: toolkit Popup in the middle, e.g. the stream info) -->
        <Rectangle
            x:Name="InfoDismissLayer"
            Fill="#80000000"
            Visibility="Collapsed"
            Tapped="OnInfoDismissLayerTapped" />

        <Border
            x:Name="InfoPane"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            MaxWidth="440"
            Margin="24"
            CornerRadius="20"
            Background="{ThemeResource PageBackgroundBrush}"
            Visibility="Collapsed" />
    </Grid>

</Page>
