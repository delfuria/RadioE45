<Page
    x:Class="RadioE45.Views.DebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">

    <!-- DEBUG-only page (Uno head, no MAUI counterpart): manual checks of the shared platform
         services (S6b) and later of audio (S7). Texts are not localized on purpose. -->
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Debug: servizi di piattaforma" />

            <TextBlock x:Name="EnvironmentText" IsTextSelectionEnabled="True" Foreground="{ThemeResource SecondaryTextBrush}" />
            <TextBlock x:Name="OpenCountText" />

            <ComboBox x:Name="ThemeBox" Header="Tema (salvato in theme_preference)" SelectionChanged="OnThemeChanged" MinWidth="200">
                <x:String>Dark</x:String>
                <x:String>Light</x:String>
                <x:String>System</x:String>
            </ComboBox>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Alert" Click="OnAlertClick" />
                <Button Content="Conferma" Click="OnConfirmClick" />
                <Button Content="Apri link" Click="OnOpenLinkClick" />
                <Button Content="Dispatcher da thread di fondo" Click="OnBackgroundDispatchClick" />
            </StackPanel>

            <TextBlock x:Name="ResultText" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="TimerText" Foreground="{ThemeResource MutedTextBrush}" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Audio live, database, rete (S7a)" />
            <TextBlock x:Name="PathsText" IsTextSelectionEnabled="True" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" />
            <TextBlock x:Name="NetworkText" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Carica stazioni" Click="OnLoadStationsClick" />
                <ComboBox x:Name="StationBox" MinWidth="200" DisplayMemberPath="Name" PlaceholderText="Stazione" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Play" Click="OnPlayClick" />
                <Button Content="Pausa" Click="OnPauseClick" />
                <Button Content="Riprendi" Click="OnResumeClick" />
                <Button Content="Stop" Click="OnStopClick" />
            </StackPanel>
            <Slider x:Name="VolumeSlider" Header="Volume" Minimum="0" Maximum="100" Value="100" MaxWidth="300" HorizontalAlignment="Left" ValueChanged="OnVolumeChanged" />
            <TextBlock x:Name="AudioText" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>

</Page>
