<Page
    x:Class="RadioE45.Views.RadioListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:RadioE45.Services.Localization"
    xmlns:conv="using:RadioE45.Converters"
    xmlns:models="using:RadioE45.Models"
    Background="{ThemeResource PageBackgroundBrush}"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- Port of RadioE45/Views/RadioListPage.xaml. Edit/delete from the context menu (right click,
         long press on touch): the MAUI SwipeView is touch-only. Reorder: drag a row onto another
         one, or onto the empty space below the list to move it to the end (same drop targets as
         MAUI). Icons are Font Awesome glyphs instead of 📻 ▶ ☰ ⟳ (no font for them on the web). -->

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitleLabel}" Text="{loc:Translate Key=Tab_Radio}" />

        <!-- Empty list -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Padding="32"
            Visibility="{x:Bind conv:Fn.IsEmpty(ViewModel.Stations), Mode=OneWay}">
            <FontIcon
                FontFamily="{StaticResource FaSolid}"
                Glyph="&#xf8d7;"
                FontSize="48"
                Foreground="{ThemeResource MutedTextBrush}" />
            <TextBlock Style="{StaticResource SubtitleLabel}" Text="{loc:Translate Key=RadioList_Empty}" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Stations, Mode=OneWay}"
            SelectionMode="None"
            Padding="0,0,0,8">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="16,8,16,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:AzuraStation">
                    <Border
                        Style="{StaticResource CardBorder}"
                        Padding="0"
                        AllowDrop="True"
                        DragOver="OnStationDragOver"
                        Drop="OnStationDrop">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Text="{loc:Translate Key=RadioList_EditStation}"
                                    Command="{x:Bind EditCommand}"
                                    CommandParameter="{x:Bind}" />
                                <MenuFlyoutItem
                                    Text="{loc:Translate Key=RadioList_DeleteStation}"
                                    Command="{x:Bind DeleteCommand}"
                                    CommandParameter="{x:Bind}" />
                            </MenuFlyout>
                        </Border.ContextFlyout>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Tap: select and play -->
                            <Button
                                Grid.Column="0"
                                Style="{StaticResource IconButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,16,0,16"
                                Command="{x:Bind PlayCommand}"
                                CommandParameter="{x:Bind}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Station icon: placeholder always underneath, so it also shows when the logo
                                         fails to load (web: logos without CORS headers) -->
                                    <Border
                                        Grid.Column="0"
                                        Width="48"
                                        Height="48"
                                        CornerRadius="12"
                                        Background="{StaticResource AccentBrush}"
                                        VerticalAlignment="Center">
                                        <Grid>
                                            <FontIcon
                                                FontFamily="{StaticResource FaSolid}"
                                                Glyph="&#xf8d7;"
                                                FontSize="20"
                                                Foreground="{ThemeResource PrimaryTextBrush}" />
                                            <Image
                                                Source="{x:Bind conv:Fn.Image(LogoUrl)}"
                                                Stretch="UniformToFill"
                                                Visibility="{x:Bind conv:Fn.IsNotNull(LogoUrl)}" />
                                        </Grid>
                                    </Border>

                                    <!-- Name and description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                Foreground="{ThemeResource PrimaryTextBrush}"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <Image
                                                Source="ms-appx:///Assets/Images/heart_filled.png"
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind IsFavorite}" />
                                            <Border
                                                Background="{StaticResource AccentBrush}"
                                                CornerRadius="6"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind HlsEnabled}">
                                                <TextBlock
                                                    Text="HLS"
                                                    Foreground="{ThemeResource PrimaryTextBrush}"
                                                    FontSize="10"
                                                    FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            Text="{x:Bind Description}"
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            FontSize="13"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind IsOnline}" />
                                        <TextBlock
                                            Text="{loc:Translate Key=RadioList_Offline}"
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            FontSize="12"
                                            FontStyle="Italic"
                                            Visibility="{x:Bind conv:Fn.Collapsed(IsOnline)}" />
                                    </StackPanel>

                                    <!-- Active station -->
                                    <FontIcon
                                        Grid.Column="2"
                                        FontFamily="{StaticResource FaSolid}"
                                        Glyph="&#xf04b;"
                                        FontSize="14"
                                        Foreground="{StaticResource AccentBrush}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                </Grid>
                            </Button>

                            <!-- Drag handle for reordering (a Button swallows the pointer, so the drag starts here) -->
                            <Border
                                Grid.Column="1"
                                Width="52"
                                Background="Transparent"
                                CanDrag="True"
                                DragStarting="OnStationDragStarting">
                                <FontIcon
                                    FontFamily="{StaticResource FaSolid}"
                                    Glyph="&#xf0c9;"
                                    FontSize="18"
                                    Foreground="{ThemeResource MutedTextBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Footer>
                <!-- Drop here to move a station to the end; room for the floating buttons. -->
                <Border
                    Height="80"
                    Background="Transparent"
                    AllowDrop="True"
                    DragOver="OnStationDragOver"
                    Drop="OnDropAtEnd" />
            </ListView.Footer>
        </ListView>

        <!-- Refresh -->
        <Button
            Grid.Row="1"
            Style="{StaticResource FabButton}"
            Content="&#xf021;"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="16,0,0,16"
            Command="{x:Bind ViewModel.ForceReloadStationsCommand}"
            IsEnabled="{x:Bind conv:Fn.Not(ViewModel.IsBusy), Mode=OneWay}" />

        <ProgressRing
            Grid.Row="1"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,12,0,0" />

        <!-- Add station -->
        <Button
            Grid.Row="1"
            Style="{StaticResource FabButton}"
            Content="&#xf067;"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,16,16"
            Command="{x:Bind ViewModel.NavigateToAddStationCommand}" />
    </Grid>

</Page>
