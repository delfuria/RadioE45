<Page
    x:Class="RadioE45.Views.SongRequestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:RadioE45.Services.Localization"
    xmlns:conv="using:RadioE45.Converters"
    xmlns:controls="using:RadioE45.Controls"
    xmlns:models="using:RadioE45.Models"
    Background="{ThemeResource PageBackgroundBrush}">

    <!-- Port of RadioE45/Views/SongRequestPage.xaml. SearchBar → TextBox (the list filters while
         typing, as in MAUI); RefreshView → RefreshContainer + F5. The MAUI keyboard handling
         (tap/scroll to unfocus, iOS "Done" bar) has no counterpart on desktop and web. -->

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:MenuButton Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBox
                Grid.Column="1"
                Margin="12,8,16,8"
                Style="{StaticResource CardTextBox}"
                PlaceholderText="{loc:Translate Key=Request_SearchPlaceholder}"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                InputScope="Search"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Error box: below the search bar; a click closes it, and it closes by itself on the
             next request (ErrorMessage back to null) -->
        <Button
            Grid.Row="1"
            Margin="16,0,16,8"
            Padding="16,12"
            CornerRadius="16"
            BorderThickness="0"
            Background="{StaticResource LiveRedBrush}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Visibility="{x:Bind conv:Fn.IsNotNull(ViewModel.ErrorMessage), Mode=OneWay}"
            Command="{x:Bind ViewModel.DismissErrorCommand}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Foreground="White"
                    FontSize="13"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
                <FontIcon
                    Grid.Column="1"
                    Glyph="&#xf00d;"
                    FontFamily="{StaticResource FaSolid}"
                    FontSize="14"
                    Foreground="White"
                    Opacity="0.8"
                    VerticalAlignment="Center" />
            </Grid>
        </Button>

        <RefreshContainer x:Name="Refresher" Grid.Row="2" RefreshRequested="OnRefreshRequested">
            <ListView
                ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AzuraCastRequestItem">
                        <Border Style="{StaticResource CardBorder}" Margin="16,8,16,0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Height="52" Width="52" CornerRadius="10">
                                    <Grid>
                                        <!-- Placeholder always underneath: it also shows when the cover fails to load (web, CORS) -->
                                        <Image Source="ms-appx:///Assets/Images/radio_placeholder.png" Stretch="Uniform" />
                                        <Image
                                            Source="{x:Bind conv:Fn.Image(ArtworkUrl)}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind conv:Fn.IsNotNull(ArtworkUrl)}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        Style="{StaticResource SubtitleLabel}"
                                        FontSize="16"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                    <TextBlock
                                        Text="{x:Bind Artist}"
                                        Style="{StaticResource CaptionLabel}"
                                        FontSize="14"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                </StackPanel>

                                <Grid Grid.Column="2" Width="90" VerticalAlignment="Center">
                                    <ProgressRing
                                        Width="24"
                                        Height="24"
                                        IsActive="{x:Bind IsRequesting, Mode=OneWay}"
                                        Visibility="{x:Bind IsRequesting, Mode=OneWay}" />
                                    <!-- Dimmed and disabled once the request is accepted -->
                                    <Button
                                        Content="{loc:Translate Key=Request_Submit}"
                                        FontSize="12"
                                        Padding="10,6"
                                        CornerRadius="14"
                                        BorderThickness="0"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource AccentBrush}"
                                        Foreground="{ThemeResource PrimaryTextBrush}"
                                        Visibility="{x:Bind conv:Fn.Collapsed(IsRequesting), Mode=OneWay}"
                                        IsEnabled="{x:Bind conv:Fn.Not(IsRequested), Mode=OneWay}"
                                        Opacity="{x:Bind conv:Fn.DimmedIf(IsRequested), Mode=OneWay}"
                                        Command="{x:Bind RequestCommand}"
                                        CommandParameter="{x:Bind}">
                                        <!-- Keep the accent when disabled: the opacity shows the state, as in MAUI -->
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource AccentPrimary}" />
                                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="White" />
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <Border Height="16" />
                </ListView.Footer>
            </ListView>
        </RefreshContainer>

        <!-- MAUI CollectionView.EmptyView; hidden while loading -->
        <StackPanel
            Grid.Row="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Padding="32"
            IsHitTestVisible="False"
            Visibility="{x:Bind conv:Fn.IsEmptyAndIdle(ViewModel.Songs, ViewModel.IsBusy), Mode=OneWay}">
            <!-- 🎵 in MAUI: no emoji font on the web -->
            <FontIcon
                Glyph="&#xf001;"
                FontFamily="{StaticResource FaSolid}"
                FontSize="48"
                Foreground="{ThemeResource MutedTextBrush}" />
            <TextBlock
                Text="{x:Bind ViewModel.EmptyResultsText, Mode=OneWay}"
                Style="{StaticResource SubtitleLabel}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Pagination: always visible, also with one page, as in MAUI -->
        <Grid Grid.Row="3" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- ◀ ▶ in MAUI: no font for them on the web -->
            <Button
                Grid.Column="0"
                Content="&#xf0d9;"
                Style="{StaticResource RoundCardButton}"
                Foreground="{ThemeResource PrimaryTextBrush}"
                AutomationProperties.Name="◀"
                Command="{x:Bind ViewModel.PreviousPageCommand}"
                IsEnabled="{x:Bind ViewModel.CanGoToPreviousPage, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                TextAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource MutedTextBrush}"
                FontSize="13">
                <Run Text="{x:Bind conv:Fn.Text(ViewModel.PageNumber), Mode=OneWay}" /><Run Text=" / " /><Run Text="{x:Bind conv:Fn.Text(ViewModel.TotalPages), Mode=OneWay}" />
            </TextBlock>
            <Button
                Grid.Column="2"
                Content="&#xf0da;"
                Style="{StaticResource RoundCardButton}"
                Foreground="{ThemeResource PrimaryTextBrush}"
                AutomationProperties.Name="▶"
                Command="{x:Bind ViewModel.NextPageCommand}"
                IsEnabled="{x:Bind ViewModel.CanGoToNextPage, Mode=OneWay}" />
        </Grid>
    </Grid>

</Page>
