<Page
    x:Class="RadioE45.Views.OpenSourceLicensesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">

    <!-- Port of RadioE45/Views/OpenSourceLicensesPage.xaml. Title, intro and notices come from the ViewModel. -->
    <ScrollViewer>
        <StackPanel Padding="16,0,16,32" Spacing="12">
            <TextBlock Style="{StaticResource PageTitleLabel}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <TextBlock
                Text="{x:Bind ViewModel.IntroText, Mode=OneWay}"
                Style="{StaticResource HintLabel}"
                TextWrapping="Wrap" />

            <TextBlock
                Text="{x:Bind ViewModel.NoticesText, Mode=OneWay}"
                FontSize="12"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
