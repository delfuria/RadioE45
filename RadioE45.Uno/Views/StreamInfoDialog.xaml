<UserControl
    x:Class="RadioE45.Views.StreamInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:RadioE45.Services.Localization"
    xmlns:vm="using:RadioE45.ViewModels">

    <!-- Port of RadioE45/Views/StreamInfoPopup.xaml (toolkit Popup, centered). Hosted by ShellPage in a
         centered pane over a dark layer: a ContentDialog would end up outside the app column on the web.
         Closed by the ✕ button, a click outside or Esc. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: always white on the accent color, whatever the theme -->
        <Grid
            Grid.Row="0"
            Padding="20,8,8,8"
            ColumnSpacing="12"
            CornerRadius="20,20,0,0"
            Background="{StaticResource AccentBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                FontFamily="{StaticResource FaSolid}"
                Glyph="&#xf05a;"
                FontSize="20"
                Foreground="White"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                Text="{x:Bind ViewModel.Title}"
                Foreground="White"
                FontSize="20"
                FontWeight="Bold"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="2"
                Content="&#xf00d;"
                FontFamily="{StaticResource FaSolid}"
                FontSize="18"
                Width="44"
                Height="44"
                CornerRadius="22"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Foreground="White"
                AutomationProperties.Name="{loc:Translate Key=Common_Close}"
                Click="OnCloseClick" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                Padding="20,16,20,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StreamInfoRow">
                        <StackPanel Spacing="2" Margin="0,0,0,14">
                            <TextBlock
                                Text="{x:Bind Label}"
                                Style="{StaticResource CaptionLabel}" />
                            <TextBlock
                                Text="{x:Bind Value}"
                                Foreground="{ThemeResource PrimaryTextBrush}"
                                FontSize="16"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
