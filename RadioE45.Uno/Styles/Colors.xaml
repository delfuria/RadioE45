<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- RadioE45 palette, from RadioE45/Resources/Styles/Colors.xaml (MAUI).
         MAUI swaps the semantic colors at runtime (ThemeService + DynamicResource); here the same
         keys live in ThemeDictionaries and are used with {ThemeResource}. Keep key names aligned
         with MAUI (docs/parity/MAUI-TO-UNO.md). -->

    <!-- Theme-independent colors -->
    <Color x:Key="AccentPrimary">#E63946</Color>
    <Color x:Key="AccentSecondary">#457B9D</Color>
    <Color x:Key="LiveRed">#FF3B30</Color>
    <Color x:Key="HlsGreen">#34C759</Color>
    <Color x:Key="AmberYellow">#FFC107</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentPrimary}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentSecondary}" />
    <SolidColorBrush x:Key="LiveRedBrush" Color="{StaticResource LiveRed}" />
    <SolidColorBrush x:Key="HlsGreenBrush" Color="{StaticResource HlsGreen}" />
    <SolidColorBrush x:Key="AmberYellowBrush" Color="{StaticResource AmberYellow}" />

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#0D0D0D" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="CardElevatedBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1FAEE" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A8DADC" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#111111" />
            <SolidColorBrush x:Key="DividerBrush" Color="#2A2A2A" />
            <!-- Fluent accent used by NavigationView selection, ToggleSwitch, Slider…: the Fluent
                 brushes read the Light/Dark variants, so all of them are set (MAUI uses Accent). -->
            <Color x:Key="SystemAccentColor">#E63946</Color>
            <Color x:Key="SystemAccentColorLight1">#E63946</Color>
            <Color x:Key="SystemAccentColorLight2">#E63946</Color>
            <Color x:Key="SystemAccentColorLight3">#E63946</Color>
            <Color x:Key="SystemAccentColorDark1">#E63946</Color>
            <Color x:Key="SystemAccentColorDark2">#E63946</Color>
            <Color x:Key="SystemAccentColorDark3">#E63946</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F8F9FA" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardElevatedBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#457B9D" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
            <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB" />
            <Color x:Key="SystemAccentColor">#E63946</Color>
            <Color x:Key="SystemAccentColorLight1">#E63946</Color>
            <Color x:Key="SystemAccentColorLight2">#E63946</Color>
            <Color x:Key="SystemAccentColorLight3">#E63946</Color>
            <Color x:Key="SystemAccentColorDark1">#E63946</Color>
            <Color x:Key="SystemAccentColorDark2">#E63946</Color>
            <Color x:Key="SystemAccentColorDark3">#E63946</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
