<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RadioE45.Views.RadioListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:RadioE45.ViewModels;assembly=RadioE45.Core"
    xmlns:models="clr-namespace:RadioE45.Models;assembly=RadioE45.Core"
    xmlns:loc="clr-namespace:RadioE45.Services.Localization"
    x:DataType="vm:RadioListViewModel"
    Title="{loc:Translate Tab_Radio}"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Barra degli strumenti: filtro (si applica mentre si scrive) e scelta della vista -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8"
            Padding="16,8,16,0">

            <Grid Grid.Column="0">
                <Entry
                    Text="{Binding FilterText}"
                    Placeholder="{loc:Translate RadioList_FilterPlaceholder}"
                    ClearButtonVisibility="Never"
                    ReturnType="Search"
                    BackgroundColor="{DynamicResource CardElevated}"
                    TextColor="{DynamicResource PrimaryText}"
                    PlaceholderColor="{DynamicResource MutedText}"
                    SemanticProperties.Description="{loc:Translate RadioList_FilterPlaceholder}" />
                <Button
                    Text="&#xf00d;"
                    FontFamily="FaSolid"
                    Command="{Binding ClearFilterCommand}"
                    IsVisible="{Binding HasFilter}"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource MutedText}"
                    WidthRequest="40"
                    HeightRequest="40"
                    Padding="0"
                    SemanticProperties.Description="{loc:Translate RadioList_ClearFilter}" />
            </Grid>

            <Button
                Grid.Column="1"
                Text="&#xf03a;"
                FontFamily="FaSolid"
                Command="{Binding ShowListViewCommand}"
                BackgroundColor="{DynamicResource CardElevated}"
                TextColor="{DynamicResource PrimaryText}"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0"
                SemanticProperties.Description="{loc:Translate RadioList_ViewList}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsListMode}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button
                Grid.Column="2"
                Text="&#xf00a;"
                FontFamily="FaSolid"
                Command="{Binding ShowGridViewCommand}"
                BackgroundColor="{DynamicResource CardElevated}"
                TextColor="{DynamicResource PrimaryText}"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0"
                SemanticProperties.Description="{loc:Translate RadioList_ViewGrid}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsGridMode}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

    <Grid Grid.Row="1">

        <CollectionView
            x:Name="ListCollection"
            Margin="0"
            ItemsSource="{Binding FilteredStations}"
            IsVisible="{Binding IsListMode}"
            SelectionMode="None"
            BackgroundColor="Transparent">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="12"
                    Padding="32">
                    <Label
                        Text="&#xf8d7;"
                        FontFamily="FaSolid"
                        TextColor="{DynamicResource MutedText}"
                        FontSize="48"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="{Binding EmptyMessage}"
                        Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AzuraStation">
                    <Grid Padding="16,8,16,0">
                        <Grid.GestureRecognizers>
                            <DropGestureRecognizer AllowDrop="True" Drop="OnStationDrop" />
                        </Grid.GestureRecognizers>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem
                                    Text="{loc:Translate RadioList_EditStation}"
                                    BackgroundColor="{DynamicResource Accent}"
                                    Command="{Binding EditCommand}"
                                    CommandParameter="{Binding .}" />
                                <SwipeItem
                                    Text="{loc:Translate Common_Delete}"
                                    BackgroundColor="{StaticResource LiveRed}"
                                    Command="{Binding DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                    <Border
                        Style="{StaticResource CardBorder}">
                        <Border.GestureRecognizers>
                            <DragGestureRecognizer CanDrag="True" DragStarting="OnStationDragStarting" />
                            <TapGestureRecognizer Command="{Binding PlayCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <FlyoutBase.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:DataType="models:AzuraStation"
                                    Text="{loc:Translate RadioList_EditStation}"
                                    Command="{Binding EditCommand}"
                                    CommandParameter="{Binding .}" />
                                <MenuFlyoutItem
                                    x:DataType="models:AzuraStation"
                                    Text="{loc:Translate RadioList_DeleteStation}"
                                    Command="{Binding DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                            </MenuFlyout>
                        </FlyoutBase.ContextFlyout>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                            <!-- Icona stazione -->
                            <Border
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource Accent}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                WidthRequest="48"
                                HeightRequest="48"
                                VerticalOptions="Center">
                                <Grid>
                                    <Image
                                        Source="{Binding LogoUrl}"
                                        Aspect="AspectFill"
                                        IsVisible="{Binding LogoUrl, Converter={toolkit:IsNotNullConverter}}" />
                                    <Label
                                        Text="&#xf8d7;"
                                        FontFamily="FaSolid"
                                        TextColor="{DynamicResource MutedText}"
                                        FontSize="22"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding LogoUrl, Converter={toolkit:IsStringNullOrEmptyConverter}}" />
                                </Grid>
                            </Border>

                            <!-- Nome e descrizione -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding Name}"
                                        TextColor="{DynamicResource PrimaryText}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center" />
                                    <Image
                                        Source="heart_filled.png"
                                        HeightRequest="14"
                                        WidthRequest="14"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding IsFavorite}" />
                                    <Border
                                        BackgroundColor="{DynamicResource Accent}"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="Transparent"
                                        Padding="5,1"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding HlsEnabled}">
                                        <Label
                                            Text="HLS"
                                            TextColor="{DynamicResource PrimaryText}"
                                            FontSize="10"
                                            FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label
                                    Text="{Binding Description}"
                                    TextColor="{DynamicResource MutedText}"
                                    FontSize="13"
                                    IsVisible="{Binding IsOnline}" />
                                <Label
                                    Text="{loc:Translate RadioList_Offline}"
                                    TextColor="{DynamicResource MutedText}"
                                    FontSize="12"
                                    FontAttributes="Italic"
                                    IsVisible="{Binding IsOnline, Converter={toolkit:InvertedBoolConverter}}" />
                            </VerticalStackLayout>

                            <!-- Indicatore stazione attiva -->
                            <Label
                                Grid.Column="2"
                                Text="&#xf04b;"
                                FontFamily="FaSolid"
                                TextColor="{DynamicResource Accent}"
                                FontSize="16"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsActive}" />

                            <!-- Maniglia di trascinamento per riordino (solo visuale, il drag parte da tutta la riga) -->
                            <Label
                                Grid.Column="3"
                                Text="&#xf0c9;"
                                FontFamily="FaSolid"
                                FontSize="20"
                                TextColor="{DynamicResource MutedText}"
                                WidthRequest="44"
                                HeightRequest="44"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                VerticalOptions="Center" />

                        </Grid>
                    </Border>
                    </SwipeView>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Grid HeightRequest="60" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <DropGestureRecognizer AllowDrop="True" Drop="OnDropAtEnd" />
                    </Grid.GestureRecognizers>
                </Grid>
            </CollectionView.Footer>

        </CollectionView>

        <!-- Vista a icone grandi: niente riordino (nessuna maniglia), modifica ed eliminazione dal menu contestuale -->
        <CollectionView
            x:Name="GridCollection"
            ItemsSource="{Binding FilteredStations}"
            IsVisible="{Binding IsGridMode}"
            SelectionMode="None"
            BackgroundColor="Transparent"
            Margin="8,8,8,0">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="8" HorizontalItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="12"
                    Padding="32">
                    <Label
                        Text="&#xf8d7;"
                        FontFamily="FaSolid"
                        TextColor="{DynamicResource MutedText}"
                        FontSize="48"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="{Binding EmptyMessage}"
                        Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AzuraStation">
                    <Border Style="{StaticResource CardBorder}" Padding="8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PlayCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <FlyoutBase.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:DataType="models:AzuraStation"
                                    Text="{loc:Translate RadioList_EditStation}"
                                    Command="{Binding EditCommand}"
                                    CommandParameter="{Binding .}" />
                                <MenuFlyoutItem
                                    x:DataType="models:AzuraStation"
                                    Text="{loc:Translate RadioList_DeleteStation}"
                                    Command="{Binding DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                            </MenuFlyout>
                        </FlyoutBase.ContextFlyout>
                        <VerticalStackLayout Spacing="8">
                            <Border
                                BackgroundColor="{DynamicResource Accent}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="110"
                                HorizontalOptions="Fill">
                                <Grid>
                                    <Label
                                        Text="&#xf8d7;"
                                        FontFamily="FaSolid"
                                        TextColor="{DynamicResource MutedText}"
                                        FontSize="36"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                    <Image
                                        Source="{Binding LogoUrl}"
                                        Aspect="AspectFill"
                                        IsVisible="{Binding LogoUrl, Converter={toolkit:IsNotNullConverter}}" />
                                    <!-- Stazione attiva -->
                                    <Label
                                        Text="&#xf04b;"
                                        FontFamily="FaSolid"
                                        TextColor="White"
                                        BackgroundColor="#66000000"
                                        FontSize="12"
                                        WidthRequest="26"
                                        HeightRequest="26"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="6"
                                        IsVisible="{Binding IsActive}" />
                                </Grid>
                            </Border>
                            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label
                                    Text="{Binding Name}"
                                    TextColor="{DynamicResource PrimaryText}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaximumWidthRequest="120"
                                    VerticalOptions="Center" />
                                <Image
                                    Source="heart_filled.png"
                                    HeightRequest="12"
                                    WidthRequest="12"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding IsFavorite}" />
                                <Border
                                    BackgroundColor="{DynamicResource Accent}"
                                    StrokeShape="RoundRectangle 6"
                                    Stroke="Transparent"
                                    Padding="5,1"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HlsEnabled}">
                                    <Label
                                        Text="HLS"
                                        TextColor="{DynamicResource PrimaryText}"
                                        FontSize="10"
                                        FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label
                                Text="{loc:Translate RadioList_Offline}"
                                TextColor="{DynamicResource MutedText}"
                                FontSize="12"
                                FontAttributes="Italic"
                                HorizontalOptions="Center"
                                IsVisible="{Binding IsOnline, Converter={toolkit:InvertedBoolConverter}}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="80" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Refresh -->
        <Button
            Text="&#xf021;"
            FontFamily="FaSolid"
            Command="{Binding ForceReloadStationsCommand}"
            IsEnabled="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}"
            HorizontalOptions="Start"
            VerticalOptions="End"
            Margin="16,0,0,16"
            BackgroundColor="{DynamicResource Accent}"
            TextColor="{DynamicResource PrimaryText}"
            CornerRadius="28"
            WidthRequest="56"
            HeightRequest="56"
            FontSize="26"
            Padding="0">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="2,4" Radius="8" Opacity="0.35" />
            </Button.Shadow>
        </Button>

        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="0,12,0,0"
            Color="{DynamicResource Accent}" />

        <!-- FAB -->
        <Button
            Text="+"
            Command="{Binding NavigateToAddStationCommand}"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,16,16"
            BackgroundColor="{DynamicResource Accent}"
            TextColor="{DynamicResource PrimaryText}"
            CornerRadius="28"
            WidthRequest="56"
            HeightRequest="56"
            FontSize="26"
            Padding="0">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="2,4" Radius="8" Opacity="0.35" />
            </Button.Shadow>
        </Button>

    </Grid>

    </Grid>

</ContentPage>
