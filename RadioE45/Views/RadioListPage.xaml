<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RadioE45.Views.RadioListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:RadioE45.ViewModels"
    xmlns:models="clr-namespace:RadioE45.Models"
    xmlns:loc="clr-namespace:RadioE45.Services.Localization"
    x:DataType="vm:RadioListViewModel"
    Title="{loc:Translate RadioList_Title}">

    <Grid>

        <CollectionView
            Margin="0"
            ItemsSource="{Binding Stations}"
            SelectionMode="None"
            BackgroundColor="Transparent">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="12"
                    Padding="32">
                    <Label
                        Text="📻"
                        FontSize="48"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="{loc:Translate RadioList_Empty}"
                        Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AzuraStation">
                    <Grid Padding="16,8,16,0">
                        <Grid.GestureRecognizers>
                            <DropGestureRecognizer AllowDrop="True" Drop="OnStationDrop" />
                        </Grid.GestureRecognizers>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem
                                    Text="{loc:Translate RadioList_EditStation}"
                                    BackgroundColor="{DynamicResource Accent}"
                                    Command="{Binding EditCommand}"
                                    CommandParameter="{Binding .}" />
                                <SwipeItem
                                    Text="{loc:Translate Common_Delete}"
                                    BackgroundColor="{StaticResource LiveRed}"
                                    Command="{Binding DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                    <Border
                        Style="{StaticResource CardBorder}">
                        <Border.GestureRecognizers>
                            <DragGestureRecognizer CanDrag="True" DragStarting="OnStationDragStarting" />
                            <TapGestureRecognizer Command="{Binding PlayCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <FlyoutBase.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:DataType="models:AzuraStation"
                                    Text="{loc:Translate RadioList_EditStation}"
                                    Command="{Binding EditCommand}"
                                    CommandParameter="{Binding .}" />
                                <MenuFlyoutItem
                                    x:DataType="models:AzuraStation"
                                    Text="{loc:Translate RadioList_DeleteStation}"
                                    Command="{Binding DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                            </MenuFlyout>
                        </FlyoutBase.ContextFlyout>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                            <!-- Icona stazione -->
                            <Border
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource Accent}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                WidthRequest="48"
                                HeightRequest="48"
                                VerticalOptions="Center">
                                <Grid>
                                    <Image
                                        Source="{Binding LogoUrl}"
                                        Aspect="AspectFill"
                                        IsVisible="{Binding LogoUrl, Converter={toolkit:IsNotNullConverter}}" />
                                    <Label
                                        Text ="📻"
                                        FontSize="22"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding LogoUrl, Converter={toolkit:IsStringNullOrEmptyConverter}}" />
                                </Grid>
                            </Border>

                            <!-- Nome e descrizione -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding Name}"
                                        TextColor="{DynamicResource PrimaryText}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center" />
                                    <Image
                                        Source="heart_filled.png"
                                        HeightRequest="14"
                                        WidthRequest="14"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding IsFavorite}" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="{Binding Description}"
                                    TextColor="{DynamicResource MutedText}"
                                    FontSize="13"
                                    IsVisible="{Binding IsOnline}" />
                                <Label
                                    Text="{loc:Translate RadioList_Offline}"
                                    TextColor="{DynamicResource MutedText}"
                                    FontSize="12"
                                    FontAttributes="Italic"
                                    IsVisible="{Binding IsOnline, Converter={toolkit:InvertedBoolConverter}}" />
                            </VerticalStackLayout>

                            <!-- Indicatore stazione attiva -->
                            <Label
                                Grid.Column="2"
                                Text="▶"
                                TextColor="{DynamicResource Accent}"
                                FontSize="16"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsActive}" />

                            <!-- Maniglia di trascinamento per riordino (solo visuale, il drag parte da tutta la riga) -->
                            <Label
                                Grid.Column="3"
                                Text="☰"
                                FontSize="20"
                                TextColor="{DynamicResource MutedText}"
                                WidthRequest="44"
                                HeightRequest="44"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                VerticalOptions="Center" />

                        </Grid>
                    </Border>
                    </SwipeView>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Grid HeightRequest="60" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <DropGestureRecognizer AllowDrop="True" Drop="OnDropAtEnd" />
                    </Grid.GestureRecognizers>
                </Grid>
            </CollectionView.Footer>

        </CollectionView>

        <!-- Refresh -->
        <Button
            Text="⟳"
            Command="{Binding ForceReloadStationsCommand}"
            IsEnabled="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}"
            HorizontalOptions="Start"
            VerticalOptions="End"
            Margin="16,0,0,16"
            BackgroundColor="{DynamicResource Accent}"
            TextColor="{DynamicResource PrimaryText}"
            CornerRadius="28"
            WidthRequest="56"
            HeightRequest="56"
            FontSize="26"
            Padding="0">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="2,4" Radius="8" Opacity="0.35" />
            </Button.Shadow>
        </Button>

        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="0,12,0,0"
            Color="{DynamicResource Accent}" />

        <!-- FAB -->
        <Button
            Text="+"
            Command="{Binding NavigateToAddStationCommand}"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,16,16"
            BackgroundColor="{DynamicResource Accent}"
            TextColor="{DynamicResource PrimaryText}"
            CornerRadius="28"
            WidthRequest="56"
            HeightRequest="56"
            FontSize="26"
            Padding="0">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="2,4" Radius="8" Opacity="0.35" />
            </Button.Shadow>
        </Button>

    </Grid>

</ContentPage>
