<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RadioE45.Views.SongRequestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:RadioE45.ViewModels"
    xmlns:models="clr-namespace:RadioE45.Models"
    xmlns:loc="clr-namespace:RadioE45.Services.Localization"
    xmlns:controls="clr-namespace:RadioE45.Controls"
    x:DataType="vm:SongRequestViewModel"
    Title="{loc:Translate Tab_Request}">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertBool" />
    </ContentPage.Resources>

    <Grid>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Tap su un'area libera chiude la tastiera (su iOS copre le tab). I tap dei controlli figli hanno la precedenza. -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnPageTapped" />
        </Grid.GestureRecognizers>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
        <controls:MenuButton
            Grid.Column="0"
            Margin="8,0,0,0"
            VerticalOptions="Center" />

        <SearchBar
            x:Name="SearchBox"
            Grid.Column="1"
            SearchButtonPressed="OnSearchButtonPressed"
            Margin="12,8"
            Placeholder="{loc:Translate Request_SearchPlaceholder}"
            Text="{Binding SearchText}"
            BackgroundColor="{DynamicResource CardElevated}"
            TextColor="{DynamicResource PrimaryText}"
            PlaceholderColor="{DynamicResource MutedText}"
            CancelButtonColor="{DynamicResource PrimaryText}" />
        </Grid>

        <!-- Box di notifica errore: sotto la barra di ricerca, non in basso, altrimenti su mobile
             la tastiera lo coprirebbe. Tap per chiudere subito; si richiude da sé alla richiesta
             successiva (ErrorMessage torna null). -->
        <Border
            Style="{StaticResource CardBorder}"
            BackgroundColor="{StaticResource LiveRed}"
            IsVisible="{Binding ErrorMessage, Converter={toolkit:IsNotNullConverter}}"
            Grid.Row="1"
            HorizontalOptions="Fill"
            Margin="16,0,16,8"
            Padding="16,12">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding DismissErrorCommand}" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label
                    Grid.Column="0"
                    Text="{Binding ErrorMessage}"
                    TextColor="White"
                    FontSize="13"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="✕"
                    TextColor="White"
                    Opacity="0.8"
                    FontSize="14"
                    VerticalOptions="Center" />
            </Grid>

        </Border>

        <RefreshView
            Grid.Row="2"
            IsRefreshing="{Binding IsBusy}"
            Command="{Binding LoadSongsCommand}">

            <CollectionView
                Scrolled="OnListScrolled"
                ItemsSource="{Binding Songs}"
                SelectionMode="None"
                BackgroundColor="Transparent">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="12"
                        Padding="32">
                        <Label
                            Text="🎵"
                            FontSize="48"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="{Binding EmptyResultsText}"
                            Style="{StaticResource SubtitleLabel}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AzuraCastRequestItem">
                        <Border
                            Style="{StaticResource CardBorder}"
                            Margin="16,8,16,0">

                            <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12">

                                <Border
                                    Grid.Column="0"
                                    HeightRequest="52"
                                    WidthRequest="52"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent">
                                    <Grid>
                                        <Image
                                            Source="{Binding ArtworkUrl}"
                                            Aspect="AspectFill"
                                            IsVisible="{Binding ArtworkUrl, Converter={toolkit:IsNotNullConverter}}" />
                                        <Image
                                            Source="radio_placeholder.png"
                                            Aspect="AspectFit"
                                            IsVisible="{Binding ArtworkUrl, Converter={toolkit:IsNullConverter}}" />
                                    </Grid>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label
                                        Text="{Binding Title}"
                                        Style="{StaticResource SubtitleLabel}"
                                        FontSize="16"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />
                                    <Label
                                        Text="{Binding Artist}"
                                        Style="{StaticResource CaptionLabel}"
                                        FontSize="14"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />
                                </VerticalStackLayout>

                                <Grid Grid.Column="2" VerticalOptions="Center" WidthRequest="90">
                                    <ActivityIndicator
                                        IsRunning="{Binding IsRequesting}"
                                        IsVisible="{Binding IsRequesting}"
                                        HeightRequest="24"
                                        WidthRequest="24" />
                                    <!-- Border + tap invece di Button: su Mac Catalyst il Button nativo ripristina il
                                         proprio background dopo lo stato "pressed", ignorando BackgroundColor — con
                                         Border il colore resta stabile su tutte le piattaforme. -->
                                    <Border
                                        IsVisible="{Binding IsRequesting, Converter={StaticResource InvertBool}}"
                                        IsEnabled="{Binding IsRequested, Converter={StaticResource InvertBool}}"
                                        BackgroundColor="{DynamicResource Accent}"
                                        StrokeShape="RoundRectangle 14"
                                        Stroke="Transparent"
                                        Padding="10,6">

                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsRequested}" Value="True">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding RequestCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Label
                                            Text="{loc:Translate Request_Submit}"
                                            TextColor="{DynamicResource PrimaryText}"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center" />
                                    </Border>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

        <!-- Paginazione: sempre visibile (anche a 1 pagina) per coerenza col resto della UI. -->
        <Grid
            Grid.Row="3"
            ColumnDefinitions="Auto,*,Auto"
            Margin="16,8,16,16">

            <Button
                Grid.Column="0"
                Text="◀"
                Command="{Binding PreviousPageCommand}"
                IsEnabled="{Binding CanGoToPreviousPage}"
                BackgroundColor="{DynamicResource CardElevated}"
                TextColor="{DynamicResource PrimaryText}"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Padding="0" />

            <Label
                Grid.Column="1"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center"
                TextColor="{DynamicResource MutedText}"
                FontSize="13">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding PageNumber}" />
                        <Span Text=" / " />
                        <Span Text="{Binding TotalPages}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Button
                Grid.Column="2"
                Text="▶"
                Command="{Binding NextPageCommand}"
                IsEnabled="{Binding CanGoToNextPage}"
                BackgroundColor="{DynamicResource CardElevated}"
                TextColor="{DynamicResource PrimaryText}"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Padding="0" />

        </Grid>

    </Grid>

    </Grid>

</ContentPage>
