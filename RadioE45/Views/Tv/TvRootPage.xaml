<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RadioE45.Views.Tv.TvRootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:RadioE45.Services.Localization"
    xmlns:controls="clr-namespace:RadioE45.Controls"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles/TvStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Contenitore della TV (docs/ANDROID-TV-ROADMAP.md §4): fila di pulsanti focusabili in alto, sezione sotto,
         dialogo proprio sopra a tutto. Margini di sicurezza 48 / 27 dp. Request e Podcast compaiono solo con la capability (stesse proprietà del telefono). -->
    <Grid>
        <Grid x:Name="Chrome" RowDefinitions="Auto,*" Padding="48,27">

            <HorizontalStackLayout Grid.Row="0" Spacing="20">
                <VerticalStackLayout Spacing="6">
                    <Button x:Name="NavOnAir" Style="{StaticResource TvButton}" Text="{loc:Translate Tab_OnAir}" Clicked="OnNavOnAirClicked" />
                    <BoxView x:Name="NavOnAirMark" HeightRequest="4" CornerRadius="2" Color="{DynamicResource Accent}" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="NavRequestBox" Spacing="6" IsVisible="{Binding NowPlaying.RequestsEnabled}">
                    <Button x:Name="NavRequest" Style="{StaticResource TvButton}" Text="{loc:Translate Tab_Request}" Clicked="OnNavRequestClicked" />
                    <BoxView x:Name="NavRequestMark" HeightRequest="4" CornerRadius="2" Color="{DynamicResource Accent}" IsVisible="False" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="NavPodcastsBox" Spacing="6" IsVisible="{Binding HasPodcasts}">
                    <Button x:Name="NavPodcasts" Style="{StaticResource TvButton}" Text="{loc:Translate Tab_Podcasts}" Clicked="OnNavPodcastsClicked" />
                    <BoxView x:Name="NavPodcastsMark" HeightRequest="4" CornerRadius="2" Color="{DynamicResource Accent}" IsVisible="False" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Button x:Name="NavStations" Style="{StaticResource TvButton}" Text="{loc:Translate Tab_Radio}" Clicked="OnNavStationsClicked" />
                    <BoxView x:Name="NavStationsMark" HeightRequest="4" CornerRadius="2" Color="{DynamicResource Accent}" IsVisible="False" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <ContentView x:Name="SectionHost" Grid.Row="1" />
        </Grid>

        <controls:TvDialogOverlay x:Name="Dialog" IsVisible="False" />
    </Grid>
</ContentPage>
