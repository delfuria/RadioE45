<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="RadioE45.Views.Tv.TvNowPlayingView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:RadioE45.ViewModels;assembly=RadioE45.Core"
    xmlns:controls="clr-namespace:RadioE45.Controls"
    xmlns:loc="clr-namespace:RadioE45.Services.Localization"
    x:DataType="vm:OnAirViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles/TvStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <toolkit:BoolToObjectConverter x:Key="FavoriteIcon" TrueObject="heart_filled.png" FalseObject="heart_outline.png" />
            <toolkit:BoolToObjectConverter x:Key="PlayPauseGlyph" x:TypeArguments="x:String" TrueObject="&#xF04C;" FalseObject="&#xF04B;" />
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Lettore per la TV: copertina a sinistra, informazioni a destra, controlli centrati sotto. Stessa logica del telefono
         (OnAirViewModel); qui solo layout e binding. Prossimo brano (copertina piccola e una riga di testo) sotto i tempi; la cronologia dei brani non c'è su TV (decisione 2026-10-23). -->
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto" ColumnSpacing="48" Padding="0,16,0,0">

        <Border
            Grid.Row="0"
            Grid.Column="0"
            WidthRequest="300"
            HeightRequest="300"
            VerticalOptions="Start"
            StrokeShape="RoundRectangle 20"
            Stroke="{DynamicResource CardElevated}"
            StrokeThickness="1"
            BackgroundColor="{DynamicResource CardBackground}">
            <Grid>
                <Image
                    Source="{Binding ArtworkUrl}"
                    Aspect="AspectFill"
                    IsVisible="{Binding ArtworkUrl, Converter={toolkit:IsNotNullConverter}}" />
                <Image
                    Source="radio_placeholder.png"
                    Aspect="AspectFit"
                    Margin="48"
                    IsVisible="{Binding ArtworkUrl, Converter={toolkit:IsNullConverter}}" />
                <Border
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="12"
                    BackgroundColor="{StaticResource LiveRed}"
                    StrokeShape="RoundRectangle 6"
                    Stroke="Transparent"
                    Padding="12,5"
                    IsVisible="{Binding NowPlaying.IsLive}">
                    <Label
                        Text="• LIVE"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold" />
                </Border>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8" VerticalOptions="Start">

            <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                <Border
                    BackgroundColor="{DynamicResource Accent}"
                    StrokeShape="RoundRectangle 14"
                    Stroke="Transparent"
                    HeightRequest="40"
                    Padding="18,0">
                    <Label
                        Text="{Binding CurrentStation.Name}"
                        FontSize="24"
                        FontAttributes="Bold"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center"
                        TextColor="White" />
                </Border>
                <Label
                    Text="{Binding NowPlaying.ListenerCount, StringFormat='👥 {0}'}"
                    FontSize="22"
                    TextColor="{DynamicResource MutedText}"
                    VerticalOptions="Center" />
                <Border
                    BackgroundColor="{StaticResource HlsGreen}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    Padding="12,4"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsHlsActive}">
                    <Label Text="HLS" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource PrimaryText}" />
                </Border>
                <ImageButton
                    x:Name="Favorite"
                    Style="{StaticResource TvImageButton}"
                    Source="{Binding IsFavorite, Converter={StaticResource FavoriteIcon}}"
                    Command="{Binding ToggleFavoriteCommand}"
                    SemanticProperties.Description="{Binding CurrentStation.Name}">
                    <ImageButton.Behaviors>
                        <controls:TvKeepFocusBehavior />
                    </ImageButton.Behaviors>
                </ImageButton>
            </HorizontalStackLayout>

            <Label
                Text="{Binding NowPlaying.Title}"
                Margin="0,8,0,0"
                FontSize="32"
                FontAttributes="Bold"
                MaxLines="2"
                LineBreakMode="TailTruncation"
                TextColor="{DynamicResource PrimaryText}" />
            <Label
                Text="{Binding NowPlaying.Artist}"
                FontSize="26"
                MaxLines="1"
                LineBreakMode="TailTruncation"
                TextColor="{DynamicResource SecondaryText}" />

            <ProgressBar
                Margin="0,10,0,0"
                Progress="{Binding TrackProgress}"
                ProgressColor="{DynamicResource Accent}"
                BackgroundColor="{DynamicResource CardElevated}" />
            <Grid ColumnDefinitions="*,*">
                <Label Grid.Column="0" Text="{Binding ElapsedTimeText}" FontSize="20" TextColor="{DynamicResource MutedText}" />
                <Label Grid.Column="1" Text="{Binding TotalTimeText}" FontSize="20" TextColor="{DynamicResource MutedText}" HorizontalOptions="End" />
            </Grid>

            <!-- Prossimo brano: copertina piccola e una riga di testo sotto i tempi, solo se il server lo pubblica -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,2,0,0" IsVisible="{Binding NowPlaying.Next, Converter={toolkit:IsNotNullConverter}}">
                <Border
                    Grid.Column="0"
                    WidthRequest="36"
                    HeightRequest="36"
                    StrokeShape="RoundRectangle 8"
                    Stroke="Transparent"
                    VerticalOptions="Center">
                    <Grid>
                        <Image
                            Source="{Binding NowPlaying.Next.ArtworkUrl}"
                            Aspect="AspectFill"
                            IsVisible="{Binding NowPlaying.Next.ArtworkUrl, Converter={toolkit:IsNotNullConverter}}" />
                        <Image
                            Source="radio_placeholder.png"
                            Aspect="AspectFit"
                            IsVisible="{Binding NowPlaying.Next.ArtworkUrl, Converter={toolkit:IsNullConverter}}" />
                    </Grid>
                </Border>
                <Label
                    Grid.Column="1"
                    FontSize="24"
                    MaxLines="1"
                    LineBreakMode="TailTruncation"
                    VerticalOptions="Center"
                    TextColor="{DynamicResource SecondaryText}">
                    <Label.Text>
                        <MultiBinding StringFormat="{}{0} – {1}">
                            <Binding Path="NowPlaying.Next.Title" />
                            <Binding Path="NowPlaying.Next.Artist" />
                        </MultiBinding>
                    </Label.Text>
                </Label>
            </Grid>

            <Label
                Text="{Binding ErrorMessage}"
                FontSize="22"
                TextColor="{StaticResource LiveRed}"
                IsVisible="{Binding ErrorMessage, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />
        </VerticalStackLayout>

        <!-- Controlli sotto copertina e informazioni, centrati: con quattro pulsanti (precedente, play, successivo,
             Schedule) a destra della copertina l'ultimo usciva dal bordo -->
    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="16" Margin="0,20,0,0" HorizontalOptions="Center">
        <VerticalStackLayout Spacing="4" WidthRequest="130" VerticalOptions="Start" IsVisible="{Binding ShowPreviousStation}">
            <Button
                Style="{StaticResource TvButton}"
                FontFamily="FaSolid"
                FontSize="30"
                Text="&#xF048;"
                Command="{Binding PreviousStationCommand}"
                SemanticProperties.Description="{Binding PreviousStationName}">
                <Button.Behaviors>
                    <controls:TvKeepFocusBehavior />
                </Button.Behaviors>
            </Button>
            <Label
                Text="{Binding PreviousStationName}"
                FontSize="16"
                MaxLines="1"
                LineBreakMode="TailTruncation"
                HorizontalTextAlignment="Center"
                TextColor="{DynamicResource MutedText}" />
        </VerticalStackLayout>
        <Button
            x:Name="PlayPause"
            Style="{StaticResource TvButton}"
            FontFamily="FaSolid"
            FontSize="36"
            MinimumWidthRequest="160"
            VerticalOptions="Start"
            Text="{Binding IsPlaying, Converter={StaticResource PlayPauseGlyph}}"
            Command="{Binding PlayPauseCommand}">
            <Button.Behaviors>
                <controls:TvKeepFocusBehavior />
            </Button.Behaviors>
        </Button>
        <VerticalStackLayout Spacing="4" WidthRequest="130" VerticalOptions="Start" IsVisible="{Binding ShowNextStation}">
            <Button
                Style="{StaticResource TvButton}"
                FontFamily="FaSolid"
                FontSize="30"
                Text="&#xF051;"
                Command="{Binding NextStationCommand}"
                SemanticProperties.Description="{Binding NextStationName}">
                <Button.Behaviors>
                    <controls:TvKeepFocusBehavior />
                </Button.Behaviors>
            </Button>
            <Label
                Text="{Binding NextStationName}"
                FontSize="16"
                MaxLines="1"
                LineBreakMode="TailTruncation"
                HorizontalTextAlignment="Center"
                TextColor="{DynamicResource MutedText}" />
        </VerticalStackLayout>
        <Button
            Style="{StaticResource TvButton}"
            VerticalOptions="Start"
            Text="{loc:Translate Tab_Schedule}"
            Command="{Binding ShowScheduleCommand}"
            IsVisible="{Binding HasSchedule}" />
        <ActivityIndicator
            IsRunning="{Binding IsBuffering}"
            IsVisible="{Binding IsBuffering}"
            Color="{DynamicResource Accent}"
            VerticalOptions="Center" />
    </HorizontalStackLayout>
    </Grid>
</ContentView>
