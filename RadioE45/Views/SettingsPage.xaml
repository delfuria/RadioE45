<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RadioE45.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:RadioE45.ViewModels"
    xmlns:loc="clr-namespace:RadioE45.Services.Localization"
    x:DataType="vm:SettingsViewModel"
    Title="{loc:Translate Tab_Settings}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,32">

            <!-- Sezione Riproduzione -->
            <Label
                Text="{loc:Translate Settings_Section_Playback}"
                Style="{StaticResource CaptionLabel}"
                HorizontalTextAlignment="Start"
                Margin="20,24,20,8"
                FontAttributes="Bold" />

            <Border Style="{StaticResource CardBorder}" Margin="16,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label
                            Text="{loc:Translate Settings_StartWithFavorite}"
                            TextColor="{DynamicResource PrimaryText}"
                            FontSize="15" />
                        <Label
                            Text="{loc:Translate Settings_StartWithFavorite_Hint}"
                            HorizontalTextAlignment = "Start"
                            Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                    <CheckBox
                        Grid.Column="1"
                        IsChecked="{Binding StartWithFavorite}"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Sezione Tema -->
            <Label
                Text="{loc:Translate Settings_Section_Theme}"
                Style="{StaticResource CaptionLabel}"
                HorizontalTextAlignment="Start"
                Margin="20,24,20,8"
                FontAttributes="Bold" />

            <Border Style="{StaticResource CardBorder}" Margin="16,0">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{loc:Translate Settings_ThemePreference}"
                        TextColor="{DynamicResource PrimaryText}"
                        FontSize="15" />
                    <Picker
                        SelectedItem="{Binding ThemePreference}"
                        TextColor="{DynamicResource PrimaryText}"
                        BackgroundColor="{DynamicResource CardElevated}">
                        <Picker.Items>
                            <x:String>Dark</x:String>
                            <x:String>Light</x:String>
                            <x:String>System</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- Salva -->
            <Button
                Text="{loc:Translate Settings_Save}"
                Command="{Binding SaveSettingsCommand}"
                BackgroundColor="{DynamicResource Accent}"
                TextColor="{DynamicResource PrimaryText}"
                CornerRadius="12"
                Margin="16,20,16,0"
                HeightRequest="50">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.4" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Button>
            
            <!-- Sezione Diagnostica -->
            <Label
                Text="{loc:Translate Settings_Section_Diagnostics}"
                Style="{StaticResource CaptionLabel}"
                HorizontalTextAlignment="Start"
                Margin="20,24,20,8"
                FontAttributes="Bold">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        NumberOfTapsRequired="2"
                        Tapped="OnDiagnosticaLabelTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Border x:Name="DiagnosticaBorder" Style="{StaticResource CardBorder}" Margin="16,0" IsVisible="False">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsDebugBuild}">
                        <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                        <Label
                            Text="{loc:Translate Settings_ResetData}"
                            TextColor="{DynamicResource PrimaryText}"
                            FontSize="15" />
                        <Label
                            Text="{loc:Translate Settings_ResetData_Hint}"
                            Style="{StaticResource CaptionLabel}" />
                        <Button
                            Text="{loc:Translate Settings_ResetDatabase}"
                            Command="{Binding ResetDatabaseCommand}"
                            BackgroundColor="{StaticResource LiveRed}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="44" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsCrashReportingAvailable}">
                        <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="{loc:Translate Settings_SendCrashes}"
                                    TextColor="{DynamicResource PrimaryText}"
                                    FontSize="15" />
                                <Label
                                    Text="{loc:Translate Settings_SendCrashes_Hint}"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                            <CheckBox
                                Grid.Column="1"
                                IsChecked="{Binding CrashReportingEnabled}"
                                VerticalOptions="Center" />
                        </Grid>
                        <Button
                            Text="{loc:Translate Settings_SendTestCrash}"
                            Command="{Binding SendCrashReportTestCommand}"
                            IsEnabled="{Binding CrashReportingEnabled}"
                            BackgroundColor="{DynamicResource Accent}"
                            TextColor="{DynamicResource PrimaryText}"
                            CornerRadius="8"
                            HeightRequest="44" >
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Property="Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Button>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Sezione Info -->
            <Label
                Text="{loc:Translate Settings_Section_Info}"
                Style="{StaticResource CaptionLabel}"
                HorizontalTextAlignment="Start"
                Margin="20,28,20,8"
                FontAttributes="Bold" />

            <Border Style="{StaticResource CardBorder}" Margin="16,0">
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{loc:Translate Settings_AppVersion}"
                            TextColor="{DynamicResource PrimaryText}"
                            FontSize="15" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding AppVersion}"
                            Style="{StaticResource CaptionLabel}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{loc:Translate Settings_DbVersion}"
                            TextColor="{DynamicResource PrimaryText}"
                            FontSize="15" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding SeedVersion, StringFormat='{}{0:F2}'}"
                            Style="{StaticResource CaptionLabel}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{loc:Translate Settings_UpdateRequired}"
                            TextColor="{DynamicResource PrimaryText}"
                            FontSize="15" />
                        <Label
                            Grid.Column="1"
                            Text="{loc:Translate Common_Yes}"
                            TextColor="{StaticResource LiveRed}"
                            FontSize="13"
                            FontAttributes="Bold"
                            IsVisible="{Binding MustUpdate}" />
                        <Label
                            Grid.Column="1"
                            Text="{loc:Translate Common_No}"
                            TextColor="{DynamicResource MutedText}"
                            FontSize="13"
                            FontAttributes="Bold"
                            IsVisible="{Binding MustUpdate, Converter={toolkit:InvertedBoolConverter}}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                    <Label
                        Text="{loc:Translate Settings_VisitSite}"
                        TextColor="{DynamicResource AccentBlue}"
                        FontSize="15">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSiteUrlTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                    <Label
                        Text="{loc:Translate Settings_Copyright}"
                        Style="{StaticResource CaptionLabel}"
                        HorizontalTextAlignment="Start" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
