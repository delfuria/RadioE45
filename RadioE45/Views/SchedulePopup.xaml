<?xml version="1.0" encoding="utf-8" ?>
<!-- Palinsesto come pannello dal basso (bottom sheet), aperto dall'icona accanto al
     prossimo brano in OnAirPage. Mostrato via IPopupService (vedi OnAirViewModel.ShowSchedule). -->
<toolkit:Popup
    x:Class="RadioE45.Views.SchedulePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:RadioE45.ViewModels"
    xmlns:models="clr-namespace:RadioE45.Models"
    xmlns:loc="clr-namespace:RadioE45.Services.Localization"
    x:DataType="vm:ScheduleViewModel"
    VerticalOptions="End"
    HorizontalOptions="Fill"
    Margin="0"
    Padding="0"
    BackgroundColor="{DynamicResource PageBackground}">

    <Grid x:Name="SheetGrid" RowDefinitions="Auto,Auto,*" Padding="0,0,0,24" BackgroundColor="{DynamicResource PageBackground}">

        <!-- Maniglia: trascinare/scorrere verso il basso chiude il pannello -->
        <Grid Grid.Row="0" Grid.RowSpan="2" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Down" Swiped="OnSwipedDown" />
            </Grid.GestureRecognizers>
        </Grid>

        <BoxView
            Grid.Row="0"
            HeightRequest="5"
            WidthRequest="40"
            CornerRadius="3"
            Margin="0,10,0,4"
            HorizontalOptions="Center"
            Color="{DynamicResource MutedText}"
            InputTransparent="True" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="20,4,8,4">
            <Label
                Grid.Column="0"
                Text="{loc:Translate Tab_Schedule}"
                TextColor="{DynamicResource PrimaryText}"
                FontSize="20"
                FontAttributes="Bold"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Text="&#xf00d;"
                FontFamily="FaSolid"
                FontSize="18"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0"
                CornerRadius="22"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource SecondaryText}"
                SemanticProperties.Description="{loc:Translate Common_Close}"
                Clicked="OnCloseClicked" />
        </Grid>

        <ActivityIndicator
            Grid.Row="2"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Start"
            Margin="0,24,0,0" />

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding ScheduleItems}"
            SelectionMode="None"
            BackgroundColor="Transparent">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="12"
                    Padding="32">
                    <Label
                        Text="📅"
                        FontSize="48"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="{loc:Translate Schedule_Empty}"
                        Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistSchedule">
                    <Border
                        Style="{StaticResource CardBorder}"
                        Margin="16,8,16,0">

                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                            <!-- Fascia oraria + badge ORA -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    TextColor="{DynamicResource TextSecondary}"
                                    FontSize="13"
                                    VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Start, StringFormat='{0:HH:mm}'}" />
                                            <Span Text=" – " />
                                            <Span Text="{Binding End, StringFormat='{0:HH:mm}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border
                                    Grid.Column="1"
                                    BackgroundColor="{DynamicResource Accent}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="Transparent"
                                    Padding="8,3"
                                    IsVisible="{Binding IsNow}">
                                    <Label
                                        Text="{loc:Translate Schedule_Now}"
                                        TextColor="{DynamicResource PrimaryText}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- Nome playlist -->
                            <Label
                                Grid.Row="1"
                                Text="{Binding Name}"
                                TextColor="{DynamicResource PrimaryText}"
                                FontSize="16"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                MaxLines="1" />

                            <!-- Data (solo se non è oggi) -->
                            <Label
                                Grid.Row="2"
                                TextColor="{DynamicResource MutedText}"
                                FontSize="12">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Start, StringFormat='{0:dddd d MMMM}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</toolkit:Popup>
