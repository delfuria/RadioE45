<?xml version="1.0" encoding="UTF-8" ?>
<!-- Stili per la vista Android TV (RadioE45/Views/Tv), uniti solo alle pagine TV: non toccano il telefono.
     Pagina logica 960x540 dp; tutto ciò che si può azionare ha lo stato Focused ben visibile
     (docs/parity/MAUI-TO-TV.md). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:Double x:Key="TvSafeMarginX">48</x:Double>
    <x:Double x:Key="TvSafeMarginY">27</x:Double>

    <Style TargetType="Button" x:Key="TvButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource CardElevated}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryText}" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Padding" Value="28,10" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                            <Setter Property="BorderWidth" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.08" />
                            <Setter Property="BorderWidth" Value="4" />
                            <Setter Property="BorderColor" Value="{DynamicResource PrimaryText}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Righe larghe di una lista (canali, palinsesto, risultati): con scala 1.08 una riga da ~1000 dp cresce di 40 dp per lato,
         esce dallo ScrollView e il bordo sparisce. Scala quasi nulla: il focus si legge dal bordo e dal colore. -->
    <Style TargetType="Button" x:Key="TvRowButton" BasedOn="{StaticResource TvButton}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                            <Setter Property="BorderWidth" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                            <Setter Property="BorderWidth" Value="6" />
                            <Setter Property="BorderColor" Value="{DynamicResource PrimaryText}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ImageButton" x:Key="TvImageButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                            <Setter Property="BorderWidth" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.15" />
                            <Setter Property="BorderWidth" Value="4" />
                            <Setter Property="BorderColor" Value="{DynamicResource PrimaryText}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry" x:Key="TvEntry">
        <Setter Property="BackgroundColor" Value="{DynamicResource CardElevated}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryText}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource MutedText}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource CardElevated}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
</ResourceDictionary>
