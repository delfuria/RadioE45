<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- ANDROID-ONLY BRANCH (android-auto-media3)
             This head ships to Google Play with Android Auto + Bluetooth MediaSession (Media3).
             iOS / MacCatalyst / Windows targets were removed on purpose — their platform code under
             Platforms/{iOS,MacCatalyst,Windows} simply isn't compiled while the only TFM is Android. -->
        <TargetFrameworks>net10.0-android</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>RadioE45</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

        <!-- Display name -->
        <ApplicationTitle>Radio E45</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.radioe45.app</ApplicationId>

        <!-- Versions — Android versionCode must be >= 1 -->
        <ApplicationDisplayVersion>0.23</ApplicationDisplayVersion>
        <ApplicationVersion>23</ApplicationVersion>

        <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- Escludi il template dei segreti dalla compilazione -->
        <Compile Remove="AppSecrets.template.cs" />
    </ItemGroup>

    <!-- Localization RESX: neutral = Italian, plus .en / .pl satellites. Declared explicitly so the
         MAUI SDK's Resources/ handling doesn't skip them; logical name resolves to
         RadioE45.Resources.Strings.AppResources, matching LocalizationResourceManager. -->
    <ItemGroup>
        <EmbeddedResource Update="Resources\Strings\*.resx">
            <Generator></Generator>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg1.svg" Color="#ffffff" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#ffffff" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
        <MauiImage Update="Resources\Images\tab_onair.png" Resize="True" BaseSize="32,32" />
        <MauiImage Update="Resources\Images\tab_radiolist.png" Resize="True" BaseSize="32,32" />
        <MauiImage Update="Resources\Images\tab_settings.png" Resize="True" BaseSize="32,32" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
        <PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
        <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Maui.Core" Version="10.0.80" />
        <PackageReference Include="Refit" Version="13.1.0" />
        <PackageReference Include="Refit.HttpClientFactory" Version="13.1.0" />
        <PackageReference Include="Sentry.Maui" Version="6.6.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />

        <!-- SQLite — sqlite-net-pcl 1.11.x rides the SQLitePCLRaw 3.x stack whose native lib is
             SourceGear.sqlite3 3.53.3 (SQLite 3.53.3). The old 2.1.x stack (bundle_green +
             lib.e_sqlite3.android 2.1.11) was flagged by GHSA-2m69-gcr7-jv3q (NU1903); the 3.x line
             has no vulnerable .android RID package, which clears the advisory. -->
        <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Xamarin.AndroidX.LocalBroadcastManager" Version="1.1.0.24" />

        <!-- AndroidX Media3 / ExoPlayer — single MediaLibraryService for Android Auto / Bluetooth (keep 1.10.x family in sync) -->
        <PackageReference Include="Xamarin.AndroidX.Media3.Session" Version="1.10.1.2" />
        <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.10.1.1" />
        <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Hls" Version="1.10.1.1" />
        <PackageReference Include="Xamarin.AndroidX.Media3.Common" Version="1.10.1.1" />

        <!-- Media3 pulls Xamarin.AndroidX.Core up to 1.19.0.1 (core-ktx classes merged into core);
             pin Core.Ktx to the matching version so it's an empty stub, else R8 dexing fails with
             duplicate androidx.core.animation.AnimatorKt (core 1.19 vs core-ktx 1.16). -->
        <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />

        <!-- ═══════════════════════════════════════════════════════════════════════════════
             HARD-PINNED TRANSITIVE ANDROIDX VERSIONS (fixes NU1608 dependency conflicts)
             ───────────────────────────────────────────────────────────────────────────────
             Media3 pulls Lifecycle.Common/Runtime up to 2.11.0.1 and Collection.Jvm up to
             1.6.0.1, but the MAUI stack still references the 2.9.2.1 / 1.5.x Lifecycle & Collection
             satellite packages, whose version ranges (< 2.9.3 / < 1.5.1) then clash. NuGet emits
             NU1608 for every mismatched satellite. Pin the ENTIRE Lifecycle + Collection family to
             the same resolved versions so the graph is internally consistent. Keep these in lock-step
             with the Media3 family above whenever bumping versions. -->
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common" Version="2.11.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common.Java8" Version="2.11.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.11.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.11.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.11.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Collection.Jvm" Version="1.6.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
        <PackageReference Include="Xamarin.AndroidX.SavedState" Version="1.5.0.1" />
        <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
    </ItemGroup>

</Project>
