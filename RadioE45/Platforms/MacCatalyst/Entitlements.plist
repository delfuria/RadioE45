<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox: obbligatorio per Mac Catalyst (App Store e Developer ID) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Connessioni di rete in uscita (streaming radio) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Hardened Runtime: il runtime .NET richiede compilazione JIT -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Hardened Runtime: il runtime .NET scrive in memoria eseguibile -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- NON aggiungere com.apple.security.cs.disable-library-validation: sembra la fix logica
         per l'errore "security policy does not allow @ path expansion" al crash di Sentry.framework,
         ma è vero il contrario. Conferma di Apple DTS (Quinn) sui developer forums:
         disabilitare library validation con hardened runtime attivo rende macOS PIÙ restrittivo
         sull'espansione di @rpath, causando esattamente questo crash. Fix vera: lasciare
         library validation abilitata (default) e assicurarsi che i framework di terze parti
         (Sentry.framework incluso) siano in Contents/Frameworks e firmati correttamente —
         cosa già vera in questo progetto. Vedi:
         https://developer.apple.com/forums/thread/776947 -->
</dict>
</plist>
