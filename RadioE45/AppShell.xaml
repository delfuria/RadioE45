<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RadioE45.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:RadioE45.Views"
    xmlns:loc="clr-namespace:RadioE45.Services.Localization"
    Shell.NavBarIsVisible="False">

    <TabBar>
        <ShellContent
            Title="{loc:Translate Tab_OnAir}"
            Icon="tab_onair.png"
            ContentTemplate="{DataTemplate views:OnAirPage}"
            Route="OnAirPage" />
        <ShellContent
            Title="{loc:Translate Tab_Radio}"
            Icon="tab_radiolist.png"
            ContentTemplate="{DataTemplate views:RadioListPage}"
            Route="RadioListPage" />
        <ShellContent
            Title="{loc:Translate Tab_Schedule}"
            Icon="tab_schedule.png"
            ContentTemplate="{DataTemplate views:SchedulePage}"
            Route="SchedulePage" />
        <ShellContent
            Title="{loc:Translate Tab_Settings}"
            Icon="tab_settings.png"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
