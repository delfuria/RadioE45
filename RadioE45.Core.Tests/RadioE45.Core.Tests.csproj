<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <RootNamespace>RadioE45.Core.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="xunit.v3" Version="4.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
        <PackageReference Include="NSubstitute" Version="6.2.0" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
        <!-- Runtime copy for NSubstitute: IDatabaseService exposes SQLite types (the Core only references it at compile time). -->
        <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RadioE45.Core\RadioE45.Core.csproj" />
        <ProjectReference Include="..\tools\ParityCheck\ParityCheck.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
